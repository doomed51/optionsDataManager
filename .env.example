# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=options_data
DB_USER=postgres
DB_PASSWORD=your_password_here

# IBKR Configuration
TWS_HOST=127.0.0.1
TWS_PORT=7496
CLIENT_ID=10

# Data Collection Settings
COLLECTION_INTERVAL_HOURS=1
DEFAULT_NUM_STRIKES=10
DEFAULT_NUM_EXPIRIES=5

# Rebuildable ThetaData Parquet analytics layer
PARQUET_ENABLED=false
PARQUET_ROOT=F:\absolute\path\to\options-parquet
PARQUET_COMPRESSION_LEVEL=3
PARQUET_TARGET_FILE_SIZE_MB=256
PARQUET_REFRESH_BATCH_SIZE=100000
PARQUET_SCHEDULER_POLL_SECONDS=30
